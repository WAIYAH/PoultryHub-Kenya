# =============================================================================
# PoultryHub Kenya: environment variables (names and safe example values only)
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development. Never commit real values.
# Full reference: API_AND_INTEGRATIONS.md §16.
#
# RULE: anything prefixed with VITE_ is bundled into the browser and is PUBLIC.
#       Never put a secret behind a VITE_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend (browser + build-time pre-rendering). PUBLIC values only.
# -----------------------------------------------------------------------------

# development | staging | production
VITE_APP_ENV=development

# Absolute site URL used for canonical links, Open Graph tags and the sitemap.
VITE_SITE_URL=http://localhost:5173

# Data source for the service layer: mock (Phases 1–2) | supabase (Phase 3+).
# Production builds refuse "mock".
VITE_DATA_SOURCE=mock

# Supabase project URL and PUBLISHABLE key (sb_publishable_…). Safe to expose; RLS protects data.
# Local stack values come from `pnpm supabase status`. Required when VITE_DATA_SOURCE=supabase.
# The app refuses to start if a secret key (sb_secret_…) is put here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile SITE key (public).
# Development default: Cloudflare's documented "always passes" test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# 2. Tooling (local CLI and CI). Not used by the app at runtime.
#    In CI these live in GitHub Environment secrets, not in files.
# -----------------------------------------------------------------------------

# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=          # secret: personal access token for `supabase link` / `db push`
# SUPABASE_DB_PASSWORD=           # secret

# -----------------------------------------------------------------------------
# 3. Edge Function secrets: DO NOT SET THEM IN THIS FILE.
#    Local:  supabase/functions/.env  (git-ignored; loaded by `supabase start` / `functions serve`)
#    Hosted: supabase secrets set NAME=value   (names cannot start with SUPABASE_)
#    Auto-provided by the platform (never set manually):
#      SUPABASE_URL, SUPABASE_SECRET_KEYS, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_JWKS, SUPABASE_DB_URL
#    Listed here so every required name is documented in one place:
# -----------------------------------------------------------------------------

# APP_ENV=development                        # development | staging | production
# ALLOWED_ORIGINS=http://localhost:5173      # comma-separated CORS allow-list

# PAYMENTS_MODE=mock                         # mock | daraja   (mock is refused when APP_ENV=production)
# MPESA_ENV=sandbox                          # sandbox | production
# MPESA_CONSUMER_KEY=                        # secret
# MPESA_CONSUMER_SECRET=                     # secret
# MPESA_PASSKEY=                             # secret: Lipa Na M-Pesa Online passkey
# MPESA_SHORTCODE=                           # BusinessShortCode (Paybill, or store number for Till)
# MPESA_PARTY_B=                             # Paybill number, or Till number for Buy Goods
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline
# MPESA_CALLBACK_BASE_URL=                   # https://<project-ref>.supabase.co/functions/v1/payments-webhook
# MPESA_CALLBACK_SECRET=                     # secret: >= 32 random URL-safe bytes; unique per environment
# MPESA_ENFORCE_IP_ALLOWLIST=false
# MPESA_ALLOWED_CALLBACK_CIDRS=              # optional, comma-separated

# RECONCILE_SECRET=                          # secret: shared with pg_cron through Supabase Vault

# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare test secret (always passes)

# EMAIL_API_KEY=                             # secret: transactional email provider (Phase 4)
# EMAIL_FROM="PoultryHub Kenya <orders@example.co.ke>"
# ORDER_ALERT_EMAIL=
# CONTACT_ALERT_EMAIL=
